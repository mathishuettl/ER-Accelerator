{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/iac/document-received-event-v1.schema.json",
  "title": "Document.Received event v1",
  "type": "object",
  "required": ["schemaVersion", "messageId", "messageKind", "messageType", "documentId", "correlationId", "occurredAt", "data"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "messageId": {"type": "string", "minLength": 1},
    "messageKind": {"const": "Event"},
    "messageType": {"const": "Document.Received"},
    "documentId": {"type": "string", "minLength": 1},
    "correlationId": {"type": "string", "minLength": 1},
    "occurredAt": {"type": "string", "format": "date-time"},
    "data": {"type": "object"}
  },
  "additionalProperties": false
}
